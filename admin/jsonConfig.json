                    "max": 1000,
                    "default": 0,
                    "disabled": "!data.remoteEnabled",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_remoteTest": {
