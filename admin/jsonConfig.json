{
    "type": "tabs",
    "i18n": true,
    "items": {
        "_generalTab": {
            "type": "panel",
            "label": "General",
            "items": {
                "keySource": {
                    "type": "select",
                    "label": "Key source",
                    "options": [
                        {
                            "label": "System-wide AI settings of admin",
                            "value": "system"
                        },
                        {
                            "label": "Store the key in the adapter",
                            "value": "adapter"
                        },
                        {
                            "label": "Central credential store",
                            "value": "central"
                        }
                    ],
                    "default": "adapter",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_systemAiInfo": {
                    "type": "staticText",
                    "text": "Provider, model and API key come from the system settings of admin, tab \"AI\". A change there restarts the instance.",
                    "hidden": "data.keySource !== 'system'",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "_systemAiFallback": {
                    "type": "staticText",
                    "text": "No API key entered: the system-wide AI settings of admin (System settings, tab \"AI\") are used.",
                    "hidden": "data.keySource !== 'adapter' || !!data.apiKey || data.provider === 'custom'",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "provider": {
                    "type": "select",
                    "label": "Provider",
                    "options": [
                        {
                            "label": "Anthropic",
                            "value": "anthropic"
                        },
                        {
                            "label": "OpenAI",
                            "value": "openai"
                        },
                        {
                            "label": "DeepSeek",
                            "value": "deepseek"
                        },
                        {
                            "label": "Google Gemini",
                            "value": "google"
                        },
                        {
                            "label": "OpenRouter",
                            "value": "openrouter"
                        },
                        {
                            "label": "OpenAI-compatible (own URL)",
                            "value": "custom"
                        }
                    ],
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "data.keySource === 'system'",
                    "newLine": true
                },
                "baseUrl": {
                    "type": "text",
                    "label": "Base URL",
                    "help": "Endpoint of the OpenAI-compatible server, e.g. http://192.168.1.10:11434/v1 (Ollama) or https://api.groq.com/openai/v1",
                    "hidden": "data.keySource === 'system' || data.provider !== 'custom'",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "apiKey": {
                    "type": "password",
                    "label": "API key",
                    "repeat": false,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "help": "Not needed for a local server without a key (Ollama, LM Studio)",
                    "hidden": "data.keySource === 'system' || data.keySource === 'central'"
                },
                "credentialId": {
                    "type": "credential",
                    "credentialType": "ai",
                    "label": "API key credential",
                    "help": "A credential of the central credential store of admin (ioBroker 8)",
                    "hidden": "data.keySource !== 'central'",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "modelId": {
                    "type": "autocompleteSendTo",
                    "command": "listModels",
                    "jsonData": "{\"provider\": ${JSON.stringify(data.provider || '')}, \"modelId\": ${JSON.stringify(data.modelId || '')}, \"baseUrl\": ${JSON.stringify(data.baseUrl || '')}, \"keySource\": ${JSON.stringify(data.keySource || 'adapter')}, \"apiKey\": ${JSON.stringify(data.apiKey || '')}, \"credentialId\": ${JSON.stringify(data.credentialId || '')}}",
                    "alsoDependsOn": ["provider", "baseUrl", "keySource", "apiKey", "credentialId"],
                    "freeSolo": true,
                    "label": "Model",
                    "help": "Choose a model of the provider or type any model ID. Empty: the default model of the provider (required for an OpenAI-compatible server)",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "data.keySource === 'system'"
                },
                "testConnection": {
                    "type": "sendTo",
                    "command": "testConnection",
                    "label": "Test connection",
                    "jsonData": "{\"provider\": ${JSON.stringify(data.provider || '')}, \"modelId\": ${JSON.stringify(data.modelId || '')}, \"baseUrl\": ${JSON.stringify(data.baseUrl || '')}, \"keySource\": ${JSON.stringify(data.keySource || 'adapter')}, \"apiKey\": ${JSON.stringify(data.apiKey || '')}, \"credentialId\": ${JSON.stringify(data.credentialId || '')}}",
                    "variant": "outlined",
                    "showProcess": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "dryRun": {
                    "type": "checkbox",
                    "label": "Simulation mode (nothing is switched)",
                    "help": "The agent says what it would switch, but does not write any state",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "longTermMemory": {
                    "type": "checkbox",
                    "label": "Long-term memory",
                    "help": "The agent keeps facts you tell it to remember (tools remember and forget) across all conversations, in the state memory.list",
                    "default": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "codeMode": {
                    "type": "checkbox",
                    "label": "Code mode: scripts for questions about many states",
                    "help": "For a question about many states (all batteries, every room) the agent writes a short script that calls its tools in a sandbox, and only the result goes to the model: faster and fewer tokens. Write permissions, simulation mode and confirmations count for every call of the script. It saves tokens only on questions with several steps (combine data, count, go through many devices); a simple question costs a little more than without it. Works best with strong models.",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "instructions": {
                    "type": "text",
                    "label": "Instructions",
                    "help": "Additional instructions for the agent",
                    "minRows": 3,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "maxRows": 12
                },
                "historyInstance": {
                    "type": "instance",
                    "adapter": "_dataSources",
                    "allowDeactivate": true,
                    "label": "History instance",
                    "help": "Empty: the default history of the system settings",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "timeZone": {
                    "type": "autocompleteSendTo",
                    "command": "listTimeZones",
                    "freeSolo": true,
                    "label": "Time zone",
                    "help": "Choose or type an IANA name such as Europe/Berlin. Empty: the time zone of the ioBroker server",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_docsHeader": {
                    "type": "header",
                    "text": "Documentation search (RAG)",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_docsInfo": {
                    "type": "staticText",
                    "text": "The agent can search the ioBroker documentation (the official docs, the source code of the core and the READMEs of the adapters) on a server of the project ioBrokerRAG (REST API v1), before it writes a script or answers how an adapter works. The question of the model is sent to this server. Only passages of permissively licensed sources go to the model. Empty URL: off.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "docsUrl": {
                    "type": "text",
                    "label": "RAG server URL",
                    "help": "For example http://192.168.1.10:8000 (without /query)",
                    "default": "",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "docsToken": {
                    "type": "password",
                    "label": "Token of the RAG server (optional)",
                    "help": "Only when the server sets IOB_RAG_TOKEN",
                    "default": "",
                    "hidden": "!data.docsUrl",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "testDocs": {
                    "type": "sendTo",
                    "command": "testDocs",
                    "label": "Test documentation search",
                    "jsonData": "{\"docsUrl\": ${JSON.stringify(data.docsUrl || '')}, \"docsToken\": ${JSON.stringify(data.docsToken || '')}}",
                    "variant": "outlined",
                    "showProcess": true,
                    "hidden": "!data.docsUrl",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "_limitsHeader": {
                    "type": "header",
                    "text": "Limits",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "requestsPerMinute": {
                    "type": "number",
                    "label": "Requests per minute per conversation",
                    "help": "Protects against loops: a script or another adapter that asks again right after every answer. Further requests of the same conversation (messenger chat, user of the admin chat, satellite, sendTo conversation, job) are refused without asking the model. 0 = no limit.",
                    "min": 0,
                    "default": 10,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "dailyTokens": {
                    "type": "number",
                    "label": "Tokens per day",
                    "help": "When the tokens of the day (from midnight in the time zone of the house, state usage.tokensToday) reach this number, the agent stops asking the model until midnight and answers every request with a note; usage.limitReached is then true. 0 = no limit.",
                    "min": 0,
                    "default": 0,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_writeTab": {
            "type": "panel",
            "label": "Write permissions",
            "items": {
                "writeRulesHelp": {
                    "type": "staticText",
                    "text": "One row per scope: an instance (hm-rpc.0) or an object ID with everything below it, or a pattern with * (hm-rpc.0.*.STATE). States that match no row can only be read. \"Confirmation required\" counts only where writing is allowed. \"Restart allowed\" counts only for a whole instance (not pi-agent or admin); every restart is confirmed in the chat.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "importInstances": {
                    "type": "sendTo",
                    "command": "importInstances",
                    "label": "Add installed instances",
                    "jsonData": "{\"writeRules\": ${JSON.stringify(data.writeRules || [])}}",
                    "useNative": true,
                    "variant": "outlined",
                    "showProcess": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "toggle_write": {
                    "type": "sendTo",
                    "command": "toggleColumn",
                    "label": "Write allowed: all on/off",
                    "jsonData": "{\"column\": \"write\", \"writeRules\": ${JSON.stringify(data.writeRules || [])}}",
                    "useNative": true,
                    "variant": "outlined",
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "toggle_confirm": {
                    "type": "sendTo",
                    "command": "toggleColumn",
                    "label": "Confirmation required: all on/off",
                    "jsonData": "{\"column\": \"confirm\", \"writeRules\": ${JSON.stringify(data.writeRules || [])}}",
                    "useNative": true,
                    "variant": "outlined",
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "toggle_restart": {
                    "type": "sendTo",
                    "command": "toggleColumn",
                    "label": "Restart allowed: all on/off",
                    "jsonData": "{\"column\": \"restart\", \"writeRules\": ${JSON.stringify(data.writeRules || [])}}",
                    "useNative": true,
                    "variant": "outlined",
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "writeRules": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "scope",
                            "title": "Scope",
                            "width": "40%",
                            "default": ""
                        },
                        {
                            "type": "checkbox",
                            "attr": "write",
                            "title": "Write allowed",
                            "width": "20%",
                            "default": false
                        },
                        {
                            "type": "checkbox",
                            "attr": "confirm",
                            "title": "Confirmation required",
                            "width": "20%",
                            "default": false,
                            "disabled": "!data.write"
                        },
                        {
                            "type": "checkbox",
                            "attr": "restart",
                            "title": "Restart allowed",
                            "width": "20%",
                            "default": false,
                            "disabled": "!/^[a-z0-9][a-z0-9_-]*\\.\\d+$/i.test(String(data.scope || '').trim()) || /^(pi-agent|admin)\\./i.test(String(data.scope || '').trim())"
                        }
                    ]
                },
                "allowUpdates": {
                    "type": "checkbox",
                    "label": "Allow adapter updates",
                    "help": "The agent may update adapters with an instance that has \"Write allowed\" (and itself), never admin or js-controller; every update is confirmed in the chat",
                    "default": false,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "textConfirmation": {
                    "type": "checkbox",
                    "label": "Confirmation by text in sendTo conversations",
                    "help": "For callers with a conversation of their own, e.g. ioBroker.assistant: the question is the answer, the next message decides. Only a plain \"yes\" confirms; anything else or 2 minutes of silence is no. By voice anyone in the room can say yes.",
                    "default": false,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "roundSpokenValues": {
                    "type": "checkbox",
                    "label": "Round values for spoken answers",
                    "help": "For callers that speak the answers, e.g. ioBroker.assistant: temperatures, percentages and wind speeds are read as whole numbers, so the answer says \"1 to 8 degrees\" instead of \"0.6 to 8 degrees\". Chats keep the exact values.",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "scriptsHeader": {
                    "type": "header",
                    "text": "Scripts of the javascript adapter",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "scriptsHelp": {
                    "type": "staticText",
                    "text": "A script runs with the rights of the javascript adapter: the write permissions of pi-agent do not reach it. Every save and every start is confirmed separately, with the change line by line.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "allowScripts": {
                    "type": "checkbox",
                    "label": "The agent may create and change scripts (folder pi-agent)",
                    "help": "Scripts of the javascript adapter in the folder script.js.pi-agent; new ones stay stopped until a start is confirmed",
                    "default": false,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "scriptInstance": {
                    "type": "instance",
                    "adapter": "javascript",
                    "label": "javascript instance of new scripts",
                    "default": "javascript.0",
                    "disabled": "!data.allowScripts",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "allowForeignScripts": {
                    "type": "checkbox",
                    "label": "Also change other scripts",
                    "help": "Scripts outside the folder pi-agent, including global scripts; Blockly and Rules stay read-only",
                    "default": false,
                    "disabled": "!data.allowScripts",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "scriptVoice": {
                    "type": "checkbox",
                    "label": "Confirm scripts by voice (sendTo conversations)",
                    "help": "The code is not read out, only what the script does and what pi-agent found in it. Needs \"Confirmation by text in sendTo conversations\".",
                    "default": false,
                    "disabled": "!data.allowScripts || !data.textConfirmation",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "expertHeader": {
                    "type": "header",
                    "text": "Advanced: regular expressions",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "writeAllow": {
                    "type": "text",
                    "label": "Write allowlist",
                    "help": "In addition to the table: one regular expression per line. A state whose ID matches one may be written.",
                    "minRows": 4,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "maxRows": 12,
                    "newLine": true
                },
                "confirmRequired": {
                    "type": "text",
                    "label": "Confirmation required",
                    "help": "In addition to the table: one regular expression per line. A write to a matching state (it must also be allowed) happens only after the user confirms it with a button in the messenger chat.",
                    "minRows": 2,
                    "maxRows": 10,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "newLine": true
                }
            }
        },
        "_messengersTab": {
            "type": "panel",
            "label": "Messengers",
            "items": {
                "messengersHelp": {
                    "type": "staticText",
                    "text": "One row per bot of a telegram or max instance. Users: user ID, user name or first name (as in the messenger adapter), separated by commas; messages from anyone else are ignored. Prefix: only messages that start with it go to the agent, e.g. /ai; empty: every message of an allowed user.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "messengers": {
                    "type": "table",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "checkbox",
                            "attr": "enabled",
                            "title": "Active",
                            "width": "8%",
                            "default": true
                        },
                        {
                            "type": "autocompleteSendTo",
                            "attr": "instance",
                            "title": "Instance",
                            "width": "25%",
                            "command": "listMessengerInstances",
                            "freeSolo": true,
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "users",
                            "title": "Allowed users",
                            "width": "30%",
                            "default": ""
                        },
                        {
                            "type": "text",
                            "attr": "prefix",
                            "title": "Prefix",
                            "width": "17%",
                            "default": ""
                        },
                        {
                            "type": "checkbox",
                            "attr": "voice",
                            "title": "Voice",
                            "width": "10%",
                            "default": true
                        },
                        {
                            "type": "checkbox",
                            "attr": "photos",
                            "title": "Photos",
                            "width": "10%",
                            "default": true
                        }
                    ]
                },
                "photosHelp": {
                    "type": "staticText",
                    "text": "Photos: photos sent to the bot go to the model with their caption, the photos of an album as one question (at most 4). A text sent right after photos without caption is their question. The model sees a photo only once and keeps notes of it for later questions. Telegram saves photos only with \"Save files\" in its settings; set \"Delete received files after (days)\" there (telegram 6.3.0+) so old ones are removed. MAX saves them always.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_speechHeader": {
                    "type": "header",
                    "text": "Speech recognition (voice messages)",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_speechInfo": {
                    "type": "staticText",
                    "text": "Voice messages to the bots with \"Voice\" ticked are turned into text and answered like a written message; the recognized text is shown in the chat first. The prefix does not apply to them. Own server: any server with the transcription API of OpenAI, for example speaches (faster-whisper) in Docker, usually without a key. OpenRouter: its speech models; without a key here the OpenRouter key of the agent or of the system settings of admin (tab \"AI\") is used. Telegram and MAX (adapter max 0.1.13 or newer) deliver voice messages.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "speechService": {
                    "type": "select",
                    "label": "Speech recognition",
                    "options": [
                        {
                            "label": "Off",
                            "value": ""
                        },
                        {
                            "label": "Own server (OpenAI-compatible)",
                            "value": "server"
                        },
                        {
                            "label": "OpenRouter",
                            "value": "openrouter"
                        }
                    ],
                    "default": "",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "speechBaseUrl": {
                    "type": "text",
                    "label": "Server URL",
                    "help": "Address of the API, for example http://192.168.1.10:8000/v1",
                    "default": "",
                    "hidden": "data.speechService !== 'server'",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "speechModel": {
                    "type": "autocompleteSendTo",
                    "command": "listSpeechModels",
                    "jsonData": "{\"speechService\": ${JSON.stringify(data.speechService || '')}, \"speechBaseUrl\": ${JSON.stringify(data.speechBaseUrl || '')}, \"speechModel\": ${JSON.stringify(data.speechModel || '')}, \"speechApiKey\": ${JSON.stringify(data.speechApiKey || '')}, \"speechLanguage\": ${JSON.stringify(data.speechLanguage || '')}}",
                    "alsoDependsOn": ["speechService", "speechBaseUrl", "speechApiKey"],
                    "freeSolo": true,
                    "label": "Speech model",
                    "help": "Choose from the list or type a model ID. Empty: openai/whisper-large-v3-turbo with OpenRouter; a server needs one of its models",
                    "default": "",
                    "hidden": "!data.speechService",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "speechApiKey": {
                    "type": "password",
                    "label": "API key for speech (optional)",
                    "default": "",
                    "hidden": "!data.speechService",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "speechLanguage": {
                    "type": "text",
                    "label": "Language",
                    "help": "Two letters, for example de or ru. Empty: detected for every message (a local server then needs longer)",
                    "default": "",
                    "hidden": "!data.speechService",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "testSpeech": {
                    "type": "sendTo",
                    "command": "testSpeech",
                    "label": "Test speech recognition",
